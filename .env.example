# === LLM (generacion) ===
# Se descarto OCI Generative AI: el registro de cuenta gratuita de Oracle
# quedo bloqueado por su sistema antifraude (ver docs/sources.md). Se usa
# Groq por defecto (API key gratis, sin tarjeta, en https://console.groq.com/keys).
# Cualquier proveedor compatible con OpenAI funciona igual, solo cambiando
# LLM_BASE_URL y LLM_CHAT_MODEL (ej. OpenRouter, Gemini, Together, etc.).
LLM_API_KEY=tu_api_key_aqui

# Modelo de chat de Groq (ver modelos disponibles: https://console.groq.com/docs/models)
LLM_CHAT_MODEL=llama-3.3-70b-versatile

# Base URL del endpoint OpenAI-compatible de Groq
LLM_BASE_URL=https://api.groq.com/openai/v1

# Nombre del proveedor, solo para mostrar en la UI (badge "Conectado a ...")
LLM_PROVIDER_NAME=Groq

# === Embeddings (locales, no requieren API key) ===
# Modelo multilingue liviano (~470MB) elegido para caber en el limite de RAM
# de Streamlit Community Cloud (deploy final, ver docs/sources.md). Si corres
# esto localmente con mas RAM/GPU disponible, puedes usar BAAI/bge-m3
# (EMBEDDING_DIMENSION=1024) para mejor calidad de retrieval.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# === Chroma ===
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=yachay_docs

# === Aplicacion ===
APP_NAME=YACHAY
APP_PORT=8501
LOG_LEVEL=INFO
LOG_FILE=./logs/yachay.jsonl

# === Chunking ===
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# === Retrieval ===
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
# Calibrado para paraphrase-multilingual-MiniLM-L12-v2 (ver src/config.py)
SIMILARITY_THRESHOLD=0.68